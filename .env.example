# Copy to .env for local dev (dotenv loads it). NEVER commit real secrets.
RACK_ENV=development
PORT=4000
DATABASE_PATH=db/development.sqlite3
# openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-64-byte-hex-secret
