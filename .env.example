# Copy to .env for local dev (dotenv loads it). NEVER commit real secrets.
RACK_ENV=development
PORT=4000
DATABASE_PATH=db/development.sqlite3
# openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-64-byte-hex-secret
# Feedback form email. All three must be set for a submission to be emailed;
# with any of them missing the feedback is still stored (feedbacks.delivered
# stays false) and nothing is sent. The destination address lives ONLY here —
# never in source, never in a rendered page.
# RESEND_API_KEY=re_replace_me
# FEEDBACK_FROM_EMAIL=feedback@your-verified-domain.example
# FEEDBACK_TO_EMAIL=you@example.com

# Crest CDN origin. Unset = serve the committed copies from public/images.
# CREST_BASE_URL=https://bobine.nyc3.cdn.digitaloceanspaces.com/football-supporters
