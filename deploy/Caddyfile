# Caddy terminates TLS and reverse-proxies to the app container.
# {$DOMAIN} is substituted from the DOMAIN env var (set in compose.yaml).
#
# Naming the site by its public domain triggers Caddy's automatic HTTPS: it
# obtains + renews a Let's Encrypt cert over HTTP-01/TLS-ALPN. This works once
# the DNSimple A record (story 1.3) resolves to this droplet's IP and ports
# 80/443 are reachable (firewall story 2.2). Certs persist in the caddy_data
# volume. Each site address below gets its own cert, so every one of these
# names must already resolve to this droplet at deploy time — an unreachable
# name fails issuance.
#
# {$LEGACY_DOMAIN} is the pre-rename hostname. It serves the app directly
# rather than redirecting, so it stays a working address in its own right. Its
# default is inlined because an unset env var would expand to an empty site
# address and stop Caddy from parsing this file at all.
#
# Both blue/green colors are listed; only one runs at a time (story 7.2).
# A dial to the stopped color's name fails instantly, fail_duration marks it
# down, and lb_try_* retries the live one — so requests are held through the
# swap window instead of dropped.
{$DOMAIN}, {$LEGACY_DOMAIN:football-supporters.lennonbaird.com} {
	reverse_proxy app_blue:4000 app_green:4000 {
		lb_try_duration 30s
		lb_try_interval 250ms
		fail_duration 10s
	}
}

# www is the one name that redirects: it is an alias of the apex, not an
# address of its own, so a page is never served from two URLs. {uri} carries
# the path + query through, and `permanent` is a 301.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
