  #boot { min-height: 100vh; display: flex; align-items: center; justify-content: center;
          color: #9DB0A2; font-family: monospace; font-size: 13px; letter-spacing: 1px; }
</style>

<script>
  window.QUIZ_DATA = <%== @quiz_data_json %>;
  window.QUIZ_LEAGUES = <%== @leagues_json %>;
