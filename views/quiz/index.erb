<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

<script id="app-src" type="text/plain">
const { useState } = React;

/* Premier League Club Recommender — client view. Static dataset + scoring weights
   come from window.QUIZ_DATA (server-owned, see Quiz::Data) so the browser and the
   Ruby scorer that renders shared /q/:slug pages can never drift. On "Show my club"
   the completed quiz (answers + weights) is POSTed to /quizzes, which returns a
   shareable slug the ShareCard surfaces. */

const D = window.QUIZ_DATA;
// Coach's view is enabled only when served from /coach (see App route).
const COACH_ENABLED = !!window.QUIZ_COACH;
// The leagues a user can switch between (empty/one = no picker).
const LEAGUES = window.QUIZ_LEAGUES || [];

// League-agnostic: the axes, questionnaire and sliders come from Quiz::Data and
// are the same whichever league you play, so they are fixed for the page's life.
const AXES = D.AXES;
const AXIS_LABEL = { Vibe: "Vibe", Play: "Play", Ethics: "Ethics", Fanbase: "Fanbase" };
const Q = D.Q;
const SLIDERS = D.SLIDERS;

// Fisher-Yates shuffle (returns a new array). Used to randomize the presentation
// order of questions and of each question's answers. Display-only: chosen values
// are stored back at their CANONICAL index so scoreAxes stays order-independent.
function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

// Everything below belongs to the *selected* league and is swapped in place by
// applyLeague when the picker changes (fed by GET /leagues/:slug). Every swap is
// immediately followed by a re-render and a quiz reset, and all reads happen
// during render, so components never see a half-switched dataset.
let LEAGUE, TEAMS, TEAM_NAMES, FLAVOR, BADGE, CHOOSER_THRESHOLD, MAX_CHOICES, AMPLIFY, CENTROID;

// Football Profile mode scores against every league at once. Its dataset (all
// leagues + the archetype table) is fetched lazily from GET /leagues the first
// time the user picks Profile (see enterProfile) and cached here.
const PROFILE_SLUG = "__profile__";
let PROFILE_DATA = null;

// Centre of a team cloud — the point the user's vector is amplified away from
// (see Quiz::Score#centroid_of). One implementation shared by applyLeague and
// the per-league profile bundles.
function centroidOf(teams, names) {
  return AXES.map((_, k) => names.reduce((s, n) => s + teams[n][k], 0) / names.length);
}

function applyLeague(d) {
  LEAGUE = d.LEAGUE;
  TEAMS = d.TEAMS;
  TEAM_NAMES = Object.keys(TEAMS);
  FLAVOR = d.FLAVOR;
  BADGE = d.BADGE;
  CHOOSER_THRESHOLD = d.CHOOSER_THRESHOLD;
  MAX_CHOICES = d.MAX_CHOICES;
  AMPLIFY = d.AMPLIFY;
  CENTROID = centroidOf(TEAMS, TEAM_NAMES);
}
applyLeague(D);

// A scoring bundle for one PROFILE_DATA.LEAGUES entry, shaped like the globals
// rankTeamsIn reads.
function leagueBundle(entry) {
  const names = Object.keys(entry.TEAMS);
  return { TEAMS: entry.TEAMS, TEAM_NAMES: names, CENTROID: centroidOf(entry.TEAMS, names), AMPLIFY: entry.AMPLIFY };
}

// ---- scoring: loadings-weighted mean per axis (league-independent) ----
function scoreAxes(answers) {
  const num = [0, 0, 0, 0], den = [0, 0, 0, 0];
  answers.forEach((oi, qIdx) => {
    if (oi == null) return;
    const q = Q[qIdx], opt = q.a[oi];
    for (let k = 0; k < 4; k++) {
      const L = q.load[k], val = opt.v[k];
      if (L > 0 && val != null) { num[k] += L * val; den[k] += L; }
    }
  });
  return num.map((n, k) => (den[k] > 0 ? n / den[k] : 5.0));
}

// Rank a given team bundle for the user vector. rankTeams is the single-league
// wrapper over the current globals; profile mode calls rankTeamsIn per league.
function rankTeamsIn(data, vec, weights) {
  const wsum = weights.reduce((s, x) => s + x, 0) || 1;
  const w = weights.map((x) => x / wsum);
  const u = vec.map((x, k) => {
    const a = data.CENTROID[k] + (x - data.CENTROID[k]) * data.AMPLIFY;
    return Math.max(0, Math.min(10, a));
  });
  return data.TEAM_NAMES
    .map((name) => {
      const t = data.TEAMS[name];
      const dist = Math.sqrt(w.reduce((s, wk, k) => s + wk * (u[k] - t[k]) * (u[k] - t[k]), 0));
      // match% is derived from the RAW user vector (no amplify): amplify is a
      // ranking spread trick and must not distort the human-facing percentage.
      // Mirrors Quiz::Score#rank_teams: match = 1 - raw_dist / DIAMETER (10).
      const raw = Math.sqrt(w.reduce((s, wk, k) => s + wk * (vec[k] - t[k]) * (vec[k] - t[k]), 0));
      const match = Math.max(0, Math.min(1, 1 - raw / 10));
      return { name, dist, sim: 1 / (1 + dist), match };
    })
    .sort((a, b) => b.sim - a.sim);
}

function rankTeams(vec, weights) {
  return rankTeamsIn({ TEAMS, TEAM_NAMES, CENTROID, AMPLIFY }, vec, weights);
}

// Slider weights as a normalized 4-vector summing to 1; anything malformed
// falls back to equal weighting. Mirrors Quiz::Archetype.weight_vector.
function archetypeWeights(weights) {
  const equal = AXES.map(() => 1 / AXES.length);
  if (!Array.isArray(weights) || weights.length !== AXES.length || !weights.every((x) => typeof x === "number")) return equal;
  const sum = weights.reduce((s, x) => s + x, 0);
  return sum > 0 ? weights.map((x) => x / sum) : equal;
}

// Rank every archetype by weighted Euclidean distance from the RAW user vector
// — the same operation as Quiz::Archetype.code_for, extended to a full ordering
// for the coach's view. Weighted (so moving a slider re-ranks) but unamplified:
// amplify exists to reach the club space, and an archetype is not a club.
// Ties keep table order (stable sort = Ruby min_by).
function rankArchetypes(vec, weights) {
  const w = archetypeWeights(weights);
  return Object.entries(D.ARCHETYPE.archetypes)
    .map(([code, row]) => {
      const dist = Math.sqrt(row.vec.reduce((s, x, k) => s + w[k] * (vec[k] - x) * (vec[k] - x), 0));
      return { code, name: row.label, sentence: row.sentence, dist };
    })
    .sort((a, b) => a.dist - b.dist);
}

// Abstract "kind of team you want" from the user vector — a literal transcription
// of Quiz::Archetype#call over the shipped ARCHETYPE table (D.ARCHETYPE):
// nearest archetype centroid wins. Returns { label, sentence }.
function archetypeFor(vec, weights) {
  const t = D.ARCHETYPE;
  if (!Array.isArray(vec) || vec.length !== 4 || !vec.every((v) => typeof v === "number")) {
    return { label: t.allMidLabel, sentence: t.allMidSentence };
  }
  const top = rankArchetypes(vec, weights)[0];
  return { label: top.name, sentence: top.sentence };
}

// ---- palette / type ----
const C = {
  pitch: "#0A1C13", pitch2: "#0F2A1C", chalk: "#EDF1EA", chalkDim: "#9DB0A2",
  amber: "#F0B23E", amberDim: "#8A6E33", line: "#20402E", lime: "#5BD98A", shadow: "rgba(0,0,0,0.35)",
};
const FONTS = `@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');`;
const mono = { fontFamily: "'Space Mono', monospace" };
const disp = { fontFamily: "'Archivo', sans-serif" };
const body = { fontFamily: "'Space Grotesk', sans-serif" };

function TraitBoard({ vec }) {
  return (
    <div style={{ display: "grid", gap: 5 }}>
      {AXES.map((ax, i) => (
        <div key={ax} style={{ display: "grid", gridTemplateColumns: "70px 1fr 32px", alignItems: "center", gap: 10 }}>
          <span style={{ ...mono, fontSize: 9.5, letterSpacing: 0.4, color: C.chalkDim, textTransform: "uppercase" }}>{AXIS_LABEL[ax]}</span>
          <div style={{ height: 7, background: "#0c2417", borderRadius: 2, overflow: "hidden", border: `1px solid ${C.line}` }}>
            <div style={{ width: `${(vec[i] / 10) * 100}%`, height: "100%", background: C.amber, transition: "width .5s cubic-bezier(.2,.8,.2,1)" }} />
          </div>
          <span style={{ ...mono, fontSize: 10.5, color: C.amber, textAlign: "right" }}>{vec[i].toFixed(1)}</span>
        </div>
      ))}
    </div>
  );
}

// Coach's-view compare table: team ranking under equal weights vs the user's
// weights. Shown in league quizzes; profile mode swaps in ArchetypeRanking.
function LiveRanking({ vec, weights, onPick }) {
  const rank = rankTeams(vec, weights);
  const eqRank = rankTeams(vec, [5, 5, 5, 5]);
  const eqSim = {}, eqPos = {};
  eqRank.forEach((r, idx) => { eqSim[r.name] = r.sim; eqPos[r.name] = idx; });
  return (
    <div style={{ display: "grid", gap: 3 }}>
      <div style={{ display: "grid", gridTemplateColumns: "18px 1fr 44px 44px 30px", alignItems: "center", gap: 8, padding: "0 8px 4px" }}>
        <span />
        <span style={{ ...mono, fontSize: 8.5, letterSpacing: 0.5, color: C.amberDim, textTransform: "uppercase" }}>team</span>
        <span style={{ ...mono, fontSize: 8.5, letterSpacing: 0.5, color: C.amberDim, textTransform: "uppercase", textAlign: "right" }}>equal</span>
        <span style={{ ...mono, fontSize: 8.5, letterSpacing: 0.5, color: C.amberDim, textTransform: "uppercase", textAlign: "right" }}>yours</span>
        <span />
      </div>
      {rank.map((r, i) => {
        const moved = eqPos[r.name] - i;
        let cue = "·", cueColor = C.chalkDim;
        if (moved > 0) { cue = `▲${moved}`; cueColor = C.lime; }
        else if (moved < 0) { cue = `▼${-moved}`; cueColor = "#E06B6B"; }
        const inChooser = i > 0 && (r.dist - rank[0].dist) < CHOOSER_THRESHOLD;
        const Row = onPick ? "button" : "div";
        const rowProps = onPick ? { className: "simrow", title: "Read this club's blurb", onClick: () => onPick(r.name) } : {};
        return (
          <Row key={r.name} {...rowProps} style={{ display: "grid", gridTemplateColumns: "18px 1fr 44px 44px 30px", alignItems: "center", gap: 8,
            width: "100%", textAlign: "left", border: "none", font: "inherit", color: "inherit",
            padding: "3px 8px", borderRadius: 6,
            background: i === 0 ? "rgba(240,178,62,.14)" : (inChooser ? "rgba(91,217,138,.07)" : "transparent") }}>
            <span style={{ ...mono, fontSize: 11, color: C.chalkDim }}>{i + 1}</span>
            <span style={{ fontSize: 13, color: i === 0 ? C.amber : C.chalk }}>{r.name}</span>
            <span style={{ ...mono, fontSize: 10.5, color: C.chalkDim, textAlign: "right" }}>{eqSim[r.name].toFixed(2)}</span>
            <span style={{ ...mono, fontSize: 10.5, color: i === 0 ? C.amber : C.chalk, textAlign: "right" }}>{r.sim.toFixed(2)}</span>
            <span style={{ ...mono, fontSize: 10, color: cueColor, textAlign: "right" }}>{cue}</span>
          </Row>
        );
      })}
    </div>
  );
}

// Coach's-view table of the current archetype ranking. Move cues are vs the
// neutral all-5s vector (the pre-answer starting point), so the coach can see
// which archetypes each answer pulls the user towards. Ranking respects the
// slider weights (see rankArchetypes), so it re-orders live as dials move.
function ArchetypeRanking({ vec, started, weights }) {
  const rank = rankArchetypes(vec, weights);
  const basePos = {};
  rankArchetypes(AXES.map(() => 5), weights).forEach((r, idx) => { basePos[r.code] = idx; });
  return (
    <div style={{ display: "grid", gap: 3 }}>
      {rank.map((r, i) => {
        let cue = "", cueColor = C.chalkDim;
        if (started) {
          const delta = basePos[r.code] - i;
          if (delta > 0) { cue = `▲${delta}`; cueColor = C.lime; }
          else if (delta < 0) { cue = `▼${-delta}`; cueColor = "#E06B6B"; }
          else { cue = "·"; }
        }
        const gap = i === 0 ? "leader" : `+${(r.dist - rank[0].dist).toFixed(2)}`;
        return (
          <div key={r.code} style={{ display: "grid", gridTemplateColumns: "18px 1fr 48px 34px", alignItems: "center", gap: 8,
            padding: "3px 8px", borderRadius: 6,
            background: i === 0 ? "rgba(240,178,62,.14)" : "transparent" }}>
            <span style={{ ...mono, fontSize: 11, color: C.chalkDim }}>{i + 1}</span>
            <span style={{ fontSize: 13, color: i === 0 ? C.amber : C.chalk }}>{r.name}</span>
            <span style={{ ...mono, fontSize: 10.5, color: C.chalkDim, textAlign: "right" }}>{gap}</span>
            <span style={{ ...mono, fontSize: 10.5, color: cueColor, textAlign: "right" }}>{cue}</span>
          </div>
        );
      })}
    </div>
  );
}

function Badge({ name, size = 92, file }) {
  // Single-league callers omit `file` and read the global BADGE map; profile
  // cards pass file explicitly since BADGE isn't the right league's map there.
  if (file === undefined) file = BADGE[name];
  const initials = name.split(" ").map((w) => w[0]).join("").slice(0, 3).toUpperCase();
  return (
    <div style={{
      width: size, height: size, flex: "0 0 auto", borderRadius: 14,
      background: `linear-gradient(160deg, ${C.pitch2}, #071410)`, border: `1.5px solid ${C.line}`,
      display: "flex", alignItems: "center", justifyContent: "center", overflow: "hidden",
      boxShadow: `inset 0 1px 0 rgba(255,255,255,.04), 0 8px 24px ${C.shadow}`,
    }}>
      {file ? (
        <img src={`/images/${file.split("/").map(encodeURIComponent).join("/")}`} alt={name}
          style={{ width: size * 0.74, height: size * 0.74, objectFit: "contain" }}
          onError={(e) => {
            e.target.style.display = "none";
            e.target.nextSibling.style.display = "block";
          }} />
      ) : null}
      <span style={{ ...disp, fontWeight: 900, fontSize: size * 0.32, color: C.amber, letterSpacing: 1,
        display: file ? "none" : "block" }}>{initials}</span>
    </div>
  );
}

// Share a completed quiz. url is minted server-side (POST /quizzes -> /q/:slug).
function ShareCard({ url, err, pick }) {
  const [note, setNote] = useState("");

  function copy() {
    if (!url) return;
    const done = () => { setNote("Link copied"); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(done, () => setNote("Copy failed — select the link and copy"));
    } else {
      setNote("Select the link and copy");
    }
  }

  function share() {
    if (!url) return;
    if (navigator.share) {
      navigator.share({ title: document.title, text: `I should support ${pick}.`, url }).catch(() => {});
    } else {
      copy();
    }
  }

  return (
    <div style={{ margin: "2px 0 26px", padding: 16, borderRadius: 12, border: `1px solid ${C.line}`, background: "rgba(0,0,0,.2)" }}>
      <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 10 }}>
        Share your result
      </div>
      {err ? (
        <div style={{ ...mono, fontSize: 12, color: "#E06B6B" }}>Couldn't save a share link. You can still screenshot your result.</div>
      ) : (
        <div>
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
            <input readOnly value={url || "Saving your result…"} onFocus={(e) => e.target.select()}
              aria-label="Shareable link to your result"
              style={{ flex: "1 1 200px", minWidth: 0, ...mono, fontSize: 13, color: C.chalk, background: C.pitch,
                border: `1px solid ${C.line}`, borderRadius: 8, padding: "10px 12px" }} />
            <button onClick={copy} disabled={!url} style={{
              ...disp, fontWeight: 800, fontSize: 14, textTransform: "uppercase",
              background: "transparent", color: url ? C.amber : C.amberDim, border: `1px solid ${url ? C.amber : C.line}`,
              borderRadius: 8, padding: "10px 16px", minHeight: 44,
            }}>Copy link</button>
            <button onClick={share} disabled={!url} style={{
              ...disp, fontWeight: 800, fontSize: 14, textTransform: "uppercase",
              background: url ? C.amber : "transparent", color: url ? "#1a1305" : C.amberDim,
              border: `1px solid ${url ? C.amber : C.line}`, borderRadius: 8, padding: "10px 16px", minHeight: 44,
            }}>Share ↗</button>
          </div>
          <div aria-live="polite" style={{ ...mono, fontSize: 11, color: C.lime, marginTop: 8, minHeight: "1em" }}>{note}</div>
        </div>
      )}
    </div>
  );
}

// League switcher under the hero headline. The headline shows the current
// league's name; this compact pill changes it. With a single league there is
// nothing to choose, so it renders nothing. Switching swaps the dataset in
// place (App#switchLeague) — no reload. Native <select> so the option list is
// normal-sized and fully keyboard-accessible.
function LeaguePicker({ value, busy, error, onChange }) {
  if (LEAGUES.length <= 1) return null;
  const current = LEAGUES.find((l) => l.slug === value);
  let status = "";
  if (busy) status = "Loading clubs…";
  else if (error) status = "Couldn't load that. Try again.";
  else if (value === PROFILE_SLUG) status = "Matching against every league.";
  else if (current) status = `Matching against ${current.name} clubs.`;
  return (
    <div style={{ margin: "0 0 24px" }}>
      <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
        <label htmlFor="league-picker" style={{
          ...mono, fontSize: 11, letterSpacing: 1, textTransform: "uppercase", color: C.chalkDim,
        }}>League</label>
        <select id="league-picker" value={value} disabled={busy} onChange={(e) => onChange(e.target.value)} style={{
          ...mono, fontSize: 14, letterSpacing: 0.3, color: error ? "#E06B6B" : C.amber, background: C.pitch2,
          border: `1px solid ${error ? "#E06B6B" : C.amber}`, borderRadius: 999, padding: "9px 14px",
          cursor: busy ? "progress" : "pointer", minHeight: 44, opacity: busy ? 0.6 : 1,
        }}>
          <optgroup label="Leagues">
            {LEAGUES.map((l) => (
              <option key={l.slug} value={l.slug} style={{ color: "#1a1305" }}>{l.name}</option>
            ))}
          </optgroup>
          <optgroup label="Across all leagues">
            <option value={PROFILE_SLUG} style={{ color: "#1a1305" }}>⚽ Football Profile</option>
          </optgroup>
        </select>
      </div>
      <div aria-live="polite" style={{
        ...mono, fontSize: 11, color: error ? "#E06B6B" : C.chalkDim, marginTop: 8, minHeight: "1em",
      }}>{status}</div>
    </div>
  );
}

function App() {
  const [stage, setStage] = useState("intro");
  const [qi, setQi] = useState(0);
  const [answers, setAnswers] = useState(Q.map(() => null));
  // Presentation order (display index -> canonical index). Questions shuffled once;
  // answers stay in their authored order. Reshuffled on reset().
  const [qOrder, setQOrder] = useState(() => shuffle(Q.map((_, i) => i)));
  const reshuffle = () => setQOrder(shuffle(Q.map((_, i) => i)));
  const [weights, setWeights] = useState(SLIDERS.map(() => 5));
  const [coach, setCoach] = useState(COACH_ENABLED);
  const [result, setResult] = useState(null);
  const [chosen, setChosen] = useState(0);
  const [override, setOverride] = useState(null);
  const [history, setHistory] = useState([]);
  const [shareUrl, setShareUrl] = useState(null);
  const [shareErr, setShareErr] = useState(false);
  const [leagueSlug, setLeagueSlug] = useState(LEAGUE ? LEAGUE.slug : "");
  const [leagueBusy, setLeagueBusy] = useState(false);
  const [leagueErr, setLeagueErr] = useState(false);
  const [profileMode, setProfileMode] = useState(false);
  const [profileBusy, setProfileBusy] = useState(false);
  const [profileErr, setProfileErr] = useState(false);
  const [profileResult, setProfileResult] = useState(null);

  const vec = scoreAxes(answers);
  // Displayed question resolved through the shuffle: qi is a DISPLAY step, cq its
  // canonical index. cOpts maps display answer slots -> canonical option indices.
  const cq = qOrder[qi];
  const cQ = Q[cq];

  // Clear all quiz progress — shared by every mode switch. Switching what we
  // match against invalidates the old answers, so we always start over.
  function resetQuiz() {
    setStage("intro"); setQi(0);
    setAnswers(Q.map(() => null)); setWeights(SLIDERS.map(() => 5));
    setResult(null); setChosen(0); setOverride(null);
    setHistory([]);
    setShareUrl(null); setShareErr(false);
    setProfileResult(null);
    reshuffle();
  }

  function setLeagueParam(slug) {
    const u = new URL(window.location.href);
    u.searchParams.set("league", slug);
    window.history.replaceState({}, "", u.toString());
  }

  // Picker dispatcher: Profile enters profile mode; otherwise switch league.
  // Leaving profile back to the league we were already on needs no refetch (the
  // league globals were never swapped away), just turning profile mode off.
  function onLeagueChange(v) {
    if (v === PROFILE_SLUG) return enterProfile();
    if (profileMode && v === leagueSlug) return exitProfile();
    switchLeague(v);
  }

  // Swap the matched-against league without a reload: fetch that league's
  // dataset, install it, and start the quiz over — the old answers were scored
  // against a different set of clubs, so keeping them would be meaningless. The
  // URL is kept in step so a reload or a shared link lands on the same league.
  function switchLeague(slug) {
    if (!slug || (slug === leagueSlug && !profileMode) || leagueBusy) return;
    setLeagueBusy(true); setLeagueErr(false);
    fetch(`/leagues/${encodeURIComponent(slug)}`, { headers: { Accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        applyLeague(d);
        setProfileMode(false);
        setLeagueSlug(slug);
        resetQuiz();
        document.title = `Which ${LEAGUE.name} Club Should You Support?`;
        setLeagueParam(slug);
      })
      .catch(() => setLeagueErr(true))
      .then(() => setLeagueBusy(false));
  }

  // Football Profile: fetch every league's dataset once (cached in PROFILE_DATA),
  // then install profile mode. Mirrors switchLeague's fetch/reset shape.
  function enterProfile() {
    if (profileMode || profileBusy) return;
    if (PROFILE_DATA) return installProfile();
    setProfileBusy(true); setProfileErr(false);
    fetch("/leagues", { headers: { Accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => { PROFILE_DATA = d; installProfile(); })
      .catch(() => setProfileErr(true))
      .then(() => setProfileBusy(false));
  }

  function installProfile() {
    setProfileMode(true);
    resetQuiz();
    document.title = "Your Football Profile";
    setLeagueParam("profile");
  }

  function exitProfile() {
    setProfileMode(false);
    resetQuiz();
    document.title = `Which ${LEAGUE.name} Club Should You Support?`;
    setLeagueParam(leagueSlug);
  }

  function chooseOption(oi) {
    const na = answers.slice();
    na[qOrder[qi]] = oi;
    setHistory((h) => [...h, { qi, answers: answers.slice() }]);
    setAnswers(na);
    if (qi < Q.length - 1) setQi(qi + 1);
    else setStage("sliders");
  }

  // Persist the completed quiz/profile and surface its shareable slug. The body
  // shape decides the server path: { profile: true } vs { league }.
  function persist(finalAnswers, finalWeights, body) {
    setShareUrl(null); setShareErr(false);
    fetch("/quizzes", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => setShareUrl(d.url))
      .catch(() => setShareErr(true));
  }

  function finish() {
    if (profileMode) return finishProfile();
    const rank = rankTeams(scoreAxes(answers), weights);
    const candidates = rank.filter((r, idx) => idx === 0 || r.dist - rank[0].dist < CHOOSER_THRESHOLD).slice(0, MAX_CHOICES);
    setResult({ rank, candidates, gap: rank[1].dist - rank[0].dist });
    setChosen(0);
    setOverride(null);
    setStage("result");
    persist(answers, weights, { answers, weights, league: LEAGUE ? LEAGUE.slug : null });
  }

  // Score the answers against every league at once: one winner per league plus
  // the abstract archetype (both derived from the same user vector).
  function finishProfile() {
    const v = scoreAxes(answers);
    const leagues = PROFILE_DATA.LEAGUES.map((entry) => {
      const top = rankTeamsIn(leagueBundle(entry), v, weights)[0];
      return {
        slug: entry.LEAGUE.slug, name: entry.LEAGUE.name,
        winner: top.name, flavor: entry.FLAVOR[top.name], crest: entry.BADGE[top.name] || null,
        matchPct: Math.round(top.match * 100),
      };
    });
    setProfileResult({ vec: v, archetype: archetypeFor(v, weights), leagues });
    setStage("result");
    persist(answers, weights, { answers, weights, profile: true });
  }

  function showTeam(name) {
    const rank = rankTeams(scoreAxes(answers), weights);
    const candidates = rank.filter((r, idx) => idx === 0 || r.dist - rank[0].dist < CHOOSER_THRESHOLD).slice(0, MAX_CHOICES);
    setResult({ rank, candidates, gap: rank[1].dist - rank[0].dist });
    setChosen(0);
    setOverride(name);
    setStage("result");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function goBack() {
    if (stage === "result") { setOverride(null); setStage("sliders"); return; }
    if (stage === "sliders") { setStage("quiz"); setQi(Q.length - 1); return; }
    if (history.length === 0) return;
    const prev = history[history.length - 1];
    setHistory((h) => h.slice(0, -1));
    setAnswers(prev.answers); setQi(prev.qi);
  }

  function reset() {
    resetQuiz();
  }

  const shell = {
    minHeight: "100vh", background: `radial-gradient(1200px 600px at 50% -10%, ${C.pitch2}, ${C.pitch} 60%)`,
    color: C.chalk, ...body, padding: "28px 18px 64px", backgroundAttachment: "fixed",
  };

  return (
    <div style={shell}>
      <style>{FONTS}</style>
      <style>{`
        * { box-sizing: border-box; }
        button { cursor: pointer; font-family: inherit; }
        @media (prefers-reduced-motion: reduce){ * { transition:none !important; animation:none !important; } }
        .qbtn:hover{ border-color:${C.amber} !important; transform:translateY(-1px); }
        .qbtn:focus-visible{ outline:2px solid ${C.lime}; outline-offset:2px; }
        .altchip:hover{ border-color:${C.amber} !important; }
        .simrow{ cursor:pointer; }
        .simrow:hover{ outline:1px solid rgba(240,178,62,.5); }
        .simrow:focus-visible{ outline:2px solid ${C.lime}; outline-offset:1px; }
        input[type=range]{ -webkit-appearance:none; appearance:none; height:6px; border-radius:999px;
          background:${C.line}; outline:none; }
        input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:20px; height:20px;
          border-radius:50%; background:${C.amber}; border:2px solid #1a1305; cursor:pointer; }
        input[type=range]::-moz-range-thumb{ width:20px; height:20px; border-radius:50%; background:${C.amber};
          border:2px solid #1a1305; cursor:pointer; }
        input[type=range]:focus-visible{ outline:2px solid ${C.lime}; outline-offset:4px; }
      `}</style>

      <div style={{ maxWidth: 620, margin: "0 auto" }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 22 }}>
          <div style={{ display: "flex", gap: 8 }}>
            {stage !== "intro" && (
              <button onClick={reset} title="Restart from the first question" style={{
                ...mono, fontSize: 10, letterSpacing: 1, textTransform: "uppercase",
                background: "transparent", color: C.chalkDim,
                border: `1px solid ${C.line}`, borderRadius: 999, padding: "5px 10px",
              }}>↺ Restart</button>
            )}
            {COACH_ENABLED && (
              <button onClick={() => setCoach((c) => !c)} style={{
                ...mono, fontSize: 10, letterSpacing: 1, textTransform: "uppercase",
                background: coach ? C.amber : "transparent", color: coach ? "#1a1305" : C.amberDim,
                border: `1px solid ${coach ? C.amber : C.amberDim}`, borderRadius: 999, padding: "5px 10px",
              }}>Coach's view</button>
            )}
          </div>
        </div>

        {stage === "intro" && (
          <div>
            <h1 style={{ ...disp, fontWeight: 900, fontSize: 52, lineHeight: 0.95, margin: "0 0 14px", letterSpacing: -1 }}>
              {profileMode
                ? <React.Fragment>BUILD YOUR<br /><span style={{ color: C.amber }}>FOOTBALL</span><br />PROFILE.</React.Fragment>
                : <React.Fragment>FIND THE<br /><span style={{ color: C.amber }}>{(LEAGUE ? LEAGUE.name : "").toUpperCase()}</span><br />CLUB YOU SHOULD<br /><span style={{ color: C.amber }}>SUPPORT.</span></React.Fragment>}
            </h1>
            <LeaguePicker value={profileMode ? PROFILE_SLUG : leagueSlug} busy={leagueBusy || profileBusy} error={leagueErr || profileErr} onChange={onLeagueChange} />
            <p style={{ color: C.chalkDim, fontSize: 16, lineHeight: 1.5, maxWidth: 470, margin: "0 0 26px" }}>
              {profileMode
                ? "Answer the same questions once and we'll match you against every league at once — your best-fit club in each, plus the kind of team you're really after."
                : <React.Fragment>Still searching for your team? Take a few minutes to answer questions about your daily life, your values, and the little things that get under your skin. Tell us what matters most, and we'll find the {LEAGUE ? LEAGUE.name : ""} club that fits you—flaws and all.</React.Fragment>}
            </p>
            <button onClick={() => setStage("quiz")} style={{
              ...disp, fontWeight: 800, fontSize: 17, letterSpacing: 0.5, textTransform: "uppercase",
              background: C.amber, color: "#1a1305", border: "none", borderRadius: 10, padding: "14px 30px", boxShadow: `0 8px 24px ${C.shadow}`,
            }}>Kick off →</button>
          </div>
        )}

        {stage === "quiz" && (
          <div>
            <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 8 }}>
              <div style={{ display: "flex", alignItems: "baseline", gap: 12 }}>
                {(qi > 0 || history.length > 0) && (
                  <button onClick={goBack} style={{
                    ...mono, fontSize: 11, letterSpacing: 0.5, textTransform: "uppercase",
                    background: "transparent", color: C.chalkDim, border: "none", padding: 0,
                  }}>← Back</button>
                )}
                <span style={{ ...mono, fontSize: 12, color: C.amber, letterSpacing: 1 }}>{String(qi + 1).padStart(2, "0")} <span style={{ color: C.amberDim }}>/ {Q.length}</span></span>
              </div>
              <span style={{ ...mono, fontSize: 11, color: C.chalkDim }}>{Math.round((qi / Q.length) * 100)}% played</span>
            </div>
            <div style={{ height: 4, background: "#0c2417", borderRadius: 999, marginBottom: 24, overflow: "hidden", border: `1px solid ${C.line}` }}>
              <div style={{ width: `${(qi / Q.length) * 100}%`, height: "100%", background: C.lime, transition: "width .4s ease" }} />
            </div>
            <h2 style={{ ...disp, fontWeight: 800, fontSize: 25, lineHeight: 1.14, margin: "0 0 20px" }}>{cQ.t}</h2>
            {coach && (
              <div style={{ ...mono, fontSize: 10.5, letterSpacing: 0.5, color: C.amberDim, margin: "-10px 0 16px", display: "flex", gap: 10, flexWrap: "wrap" }}>
                <span style={{ textTransform: "uppercase", letterSpacing: 1 }}>Loadings:</span>
                {AXES.map((ax, k) => (
                  <span key={ax} style={{ color: cQ.load[k] > 0 ? C.amber : "#3a5140" }}>
                    {ax[0]}·{cQ.load[k]}
                  </span>
                ))}
              </div>
            )}
            <div style={{ display: "grid", gap: 10 }}>
              {cQ.a.map((opt, i) => (
                <button key={i} className="qbtn" onClick={() => chooseOption(i)} style={{
                  textAlign: "left", background: answers[cq] === i ? "rgba(240,178,62,.12)" : C.pitch2,
                  color: C.chalk, border: `1px solid ${answers[cq] === i ? C.amber : C.line}`,
                  borderRadius: 10, padding: "15px 16px", fontSize: 15.5, lineHeight: 1.35,
                  transition: "border-color .15s, transform .15s", display: "flex", gap: 12, alignItems: "flex-start",
                }}>
                  <span style={{ ...mono, fontSize: 13, color: C.amber, flex: "0 0 auto", marginTop: 1 }}>{"abcd"[i]}</span>
                  <span style={{ flex: 1 }}>{opt.l}</span>
                  {coach && (
                    <span style={{ ...mono, fontSize: 10.5, color: C.chalkDim, flex: "0 0 auto", marginTop: 2, textAlign: "right", whiteSpace: "nowrap" }}>
                      {AXES.map((ax, k) => (
                        cQ.load[k] > 0
                          ? <span key={ax} style={{ marginLeft: 7, color: opt.v[k] == null ? "#3a5140" : C.chalk }}>
                              {ax[0]}{opt.v[k] == null ? "—" : opt.v[k]}
                            </span>
                          : null
                      ))}
                    </span>
                  )}
                </button>
              ))}
            </div>
            {coach && (
              <div style={{ marginTop: 24, padding: 14, borderRadius: 10, border: `1px dashed ${C.amberDim}`, background: "rgba(0,0,0,.2)" }}>
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 10, display: "flex", justifyContent: "space-between" }}>
                  <span>{profileMode ? "Live ranking · archetypes" : "Live ranking · teams"}</span>
                  <span style={{ color: C.chalkDim }}>{profileMode ? "gap · move vs neutral" : "equal vs your weights"}</span>
                </div>
                {profileMode
                  ? <ArchetypeRanking vec={vec} started={history.length > 0} weights={weights} />
                  : <LiveRanking vec={vec} weights={weights} />}
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", margin: "16px 0 10px" }}>Live trait board</div>
                <TraitBoard vec={vec} />
              </div>
            )}
          </div>
        )}

        {stage === "sliders" && (
          <div>
            <button onClick={goBack} style={{
              ...mono, fontSize: 11, letterSpacing: 0.5, textTransform: "uppercase",
              background: "transparent", color: C.chalkDim, border: "none", padding: 0, marginBottom: 16,
            }}>← Back</button>
            <div style={{ ...mono, fontSize: 12, color: C.lime, letterSpacing: 1, marginBottom: 10 }}>Last bit · what matters to you</div>
            <h2 style={{ ...disp, fontWeight: 800, fontSize: 27, lineHeight: 1.05, margin: "0 0 8px" }}>How much does each thing count?</h2>
            <p style={{ color: C.chalkDim, fontSize: 14.5, lineHeight: 1.5, margin: "0 0 26px" }}>
              These are relative priorities — sliding everything to the top is the same as leaving everything in the middle. Only the balance between them changes your match.
            </p>
            <div style={{ display: "grid", gap: 22 }}>
              {SLIDERS.map((s, i) => (
                <div key={s.ax}>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 8 }}>
                    <span style={{ ...disp, fontWeight: 700, fontSize: 16 }}>{s.q}</span>
                    <span style={{ ...mono, fontSize: 13, color: C.amber }}>{weights[i]}</span>
                  </div>
                  <input type="range" min="1" max="10" value={weights[i]} style={{ width: "100%" }}
                    onChange={(e) => { const w = weights.slice(); w[i] = +e.target.value; setWeights(w); }} />
                  <div style={{ display: "flex", justifyContent: "space-between", marginTop: 5 }}>
                    <span style={{ ...mono, fontSize: 10, color: C.chalkDim }}>{s.lo}</span>
                    <span style={{ ...mono, fontSize: 10, color: C.chalkDim, textAlign: "right" }}>{s.hi}</span>
                  </div>
                </div>
              ))}
            </div>
            {coach && (
              <div style={{ marginTop: 26, padding: 16, borderRadius: 12, border: `1px solid ${C.line}`, background: "rgba(0,0,0,.2)" }}>
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 12 }}>Your four attributes</div>
                <TraitBoard vec={vec} />
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", margin: "18px 0 4px", display: "flex", justifyContent: "space-between" }}>
                  <span>{profileMode ? "Ranking · archetypes" : "Ranking · equal vs your weights"}</span>
                  <span style={{ color: C.chalkDim }}>{profileMode ? "gap · move vs neutral" : "▲▼ move vs equal"}</span>
                </div>
                {profileMode
                  ? <ArchetypeRanking vec={vec} started weights={weights} />
                  : <LiveRanking vec={vec} weights={weights} onPick={showTeam} />}
              </div>
            )}
            <button onClick={finish} style={{
              ...disp, fontWeight: 800, fontSize: 17, letterSpacing: 0.5, textTransform: "uppercase", marginTop: 26,
              background: C.amber, color: "#1a1305", border: "none", borderRadius: 10, padding: "14px 30px", boxShadow: `0 8px 24px ${C.shadow}`,
            }}>Show my club →</button>
          </div>
        )}

        {stage === "result" && result && (() => {
          const pick = (override && result.rank.find((r) => r.name === override)) || result.candidates[chosen];
          const others = result.candidates.filter((_, i) => i !== chosen);
          const hasAlts = result.candidates.length > 1;
          return (
            <div>
              <div style={{ ...mono, fontSize: 12, color: C.lime, letterSpacing: 1, marginBottom: 14 }}>
                {hasAlts ? "Full time · it's close — take your pick" : "Full time · your club"}
              </div>
              <div style={{ display: "flex", gap: 18, alignItems: "center", marginBottom: 18 }}>
                <Badge name={pick.name} />
                <h1 style={{ ...disp, fontWeight: 900, fontSize: 38, lineHeight: 0.95, margin: 0, letterSpacing: -1 }}>{pick.name}</h1>
              </div>
              <p style={{ fontSize: 17, lineHeight: 1.5, color: C.chalk, margin: "0 0 24px" }}>{FLAVOR[pick.name]}</p>

              <ShareCard url={shareUrl} err={shareErr} pick={pick.name} />

              {hasAlts && (
                <div style={{ marginBottom: 26 }}>
                  <div style={{ ...mono, fontSize: 11, letterSpacing: 1, color: C.chalkDim, textTransform: "uppercase", marginBottom: 10 }}>Or maybe you're more…</div>
                  <div style={{ display: "grid", gap: 8 }}>
                    {others.map((o) => (
                      <button key={o.name} className="altchip" onClick={() => { setChosen(result.candidates.indexOf(o)); setOverride(null); }} style={{
                        textAlign: "left", background: C.pitch2, color: C.chalk, border: `1px solid ${C.line}`,
                        borderRadius: 10, padding: "12px 14px", transition: "border-color .15s", display: "flex", gap: 12, alignItems: "center",
                      }}>
                        <Badge name={o.name} size={40} />
                        <span>
                          <span style={{ ...disp, fontWeight: 800, fontSize: 16 }}>{o.name}</span>
                          <span style={{ display: "block", color: C.chalkDim, fontSize: 12.5, lineHeight: 1.3, marginTop: 2 }}>
                            {FLAVOR[o.name].split(". ")[0]}.
                          </span>
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div style={{ display: "flex", gap: 10 }}>
                <button onClick={goBack} style={{
                  ...disp, fontWeight: 800, fontSize: 15, textTransform: "uppercase",
                  background: "transparent", color: C.chalkDim, border: `1px solid ${C.line}`, borderRadius: 10, padding: "12px 24px",
                }}>← Adjust dials</button>
                <button onClick={reset} style={{
                  ...disp, fontWeight: 800, fontSize: 15, textTransform: "uppercase",
                  background: "transparent", color: C.amber, border: `1px solid ${C.amber}`, borderRadius: 10, padding: "12px 24px",
                }}>Play again ↺</button>
              </div>

              {coach && (
                <div style={{ marginTop: 30, padding: 16, borderRadius: 12, border: `1px dashed ${C.amberDim}`, background: "rgba(0,0,0,.22)" }}>
                  <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 12 }}>
                    Similarity table · top-2 gap {result.gap.toFixed(3)} · {result.candidates.length} candidate{result.candidates.length > 1 ? "s" : ""} within {CHOOSER_THRESHOLD} · tap a team to read its blurb
                  </div>
                  <div style={{ display: "grid", gap: 3, marginBottom: 18 }}>
                    {result.rank.map((r, i) => {
                      const inPool = result.candidates.some((c) => c.name === r.name);
                      const isPick = r.name === pick.name;
                      return (
                        <button key={r.name} className="simrow" title="Read this club's blurb"
                          onClick={() => { setOverride(r.name); window.scrollTo({ top: 0, behavior: "smooth" }); }}
                          style={{ display: "grid", gridTemplateColumns: "22px 1fr 56px", alignItems: "center", gap: 8, width: "100%",
                          textAlign: "left", border: "none", padding: "4px 8px", borderRadius: 6,
                          background: isPick ? "rgba(240,178,62,.24)" : (inPool ? "rgba(240,178,62,.12)" : "transparent") }}>
                          <span style={{ ...mono, fontSize: 11, color: C.chalkDim }}>{i + 1}</span>
                          <span style={{ fontSize: 13.5, color: (isPick || inPool) ? C.amber : C.chalk }}>{r.name}</span>
                          <span style={{ ...mono, fontSize: 11, color: C.chalkDim, textAlign: "right" }}>{r.sim.toFixed(3)}</span>
                        </button>
                      );
                    })}
                  </div>
                  <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 10 }}>Your vector · weights [{weights.join(", ")}]</div>
                  <TraitBoard vec={vec} />
                </div>
              )}
            </div>
          );
        })()}

        {stage === "result" && profileMode && profileResult && (
          <div>
            <div style={{ ...mono, fontSize: 12, color: C.lime, letterSpacing: 1, marginBottom: 14 }}>
              Full time · your football profile
            </div>
            <h1 style={{ ...disp, fontWeight: 900, fontSize: 40, lineHeight: 0.95, margin: "0 0 8px", letterSpacing: -1, color: C.amber }}>
              {profileResult.archetype.label}
            </h1>
            <p style={{ fontSize: 16, lineHeight: 1.5, color: C.chalk, margin: "0 0 26px" }}>{profileResult.archetype.sentence}</p>

            <div style={{ ...mono, fontSize: 11, letterSpacing: 1, color: C.chalkDim, textTransform: "uppercase", marginBottom: 10 }}>Your club in every league</div>
            <div style={{ display: "grid", gap: 8, marginBottom: 26 }}>
              {profileResult.leagues.map((l) => (
                <details key={l.slug} style={{
                  background: C.pitch2, border: `1px solid ${C.line}`, borderRadius: 12 }}>
                  <summary style={{ display: "grid", gridTemplateColumns: "auto 1fr auto auto", gap: 14, alignItems: "center",
                    padding: "12px 14px", cursor: "pointer", listStyle: "none" }}>
                    <Badge name={l.winner} file={l.crest} size={44} />
                    <span style={{ minWidth: 0 }}>
                      <span style={{ ...mono, fontSize: 10, letterSpacing: 1, textTransform: "uppercase", color: C.amberDim, display: "block" }}>{l.name}</span>
                      <span style={{ ...disp, fontWeight: 800, fontSize: 16 }}>{l.winner}</span>
                      <span style={{ display: "block", color: C.chalkDim, fontSize: 12.5, lineHeight: 1.3, marginTop: 2 }}>{l.flavor.split(". ")[0]}.</span>
                    </span>
                    <span style={{ textAlign: "right", whiteSpace: "nowrap" }}>
                      <span style={{ ...disp, fontWeight: 900, fontSize: 22, color: C.amber }}>{l.matchPct}</span>
                      <span style={{ ...mono, fontSize: 9, letterSpacing: 0.5, textTransform: "uppercase", color: C.chalkDim, display: "block" }}>% match</span>
                    </span>
                    <span aria-hidden="true" style={{ color: C.chalkDim, fontSize: 14 }}>▾</span>
                  </summary>
                  <p style={{ color: C.chalkDim, fontSize: 13, lineHeight: 1.45, margin: 0, padding: "0 14px 14px" }}>{l.flavor}</p>
                </details>
              ))}
            </div>

            <ShareCard url={shareUrl} err={shareErr} pick={profileResult.archetype.label} />

            <div style={{ display: "flex", gap: 10 }}>
              <button onClick={reset} style={{
                ...disp, fontWeight: 800, fontSize: 15, textTransform: "uppercase",
                background: "transparent", color: C.amber, border: `1px solid ${C.amber}`, borderRadius: 10, padding: "12px 24px",
              }}>Play again ↺</button>
            </div>

            {coach && (
              <div style={{ marginTop: 30, padding: 16, borderRadius: 12, border: `1px dashed ${C.amberDim}`, background: "rgba(0,0,0,.22)" }}>
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 12 }}>Per-league fit · match %</div>
                <div style={{ display: "grid", gap: 6, marginBottom: 18 }}>
                  {profileResult.leagues.map((l) => (
                    <div key={l.slug} style={{ display: "grid", gridTemplateColumns: "30px 1fr 34px", alignItems: "center", gap: 10 }}>
                      <Badge name={l.winner} file={l.crest} size={28} />
                      <div style={{ height: 7, background: "#0c2417", borderRadius: 2, overflow: "hidden", border: `1px solid ${C.line}` }}>
                        <div style={{ width: `${l.matchPct}%`, height: "100%", background: C.amber }} />
                      </div>
                      <span style={{ ...mono, fontSize: 11, color: C.amber, textAlign: "right" }}>{l.matchPct}</span>
                    </div>
                  ))}
                </div>
                <div style={{ ...mono, fontSize: 10, letterSpacing: 1, color: C.amberDim, textTransform: "uppercase", marginBottom: 10 }}>Your vector · weights [{weights.join(", ")}]</div>
                <TraitBoard vec={profileResult.vec} />
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App />);
</script>
<script>
  (function () {
    function fail(err) {
      document.getElementById("root").innerHTML =
        '<div style="color:#EDF1EA;font-family:monospace;padding:40px;max-width:600px;margin:0 auto;">' +
        '<b>Something went wrong loading the quiz.</b><br/><br/>' +
        'This page needs an internet connection (it loads React from a CDN). ' +
        'If you are online and still see this, try a hard refresh.<br/><br/>' +
        '<span style="color:#9DB0A2;font-size:12px;">' + String(err) + '</span></div>';
      console.error(err);
    }
    function boot() {
      if (typeof Babel === "undefined" || typeof React === "undefined" || typeof ReactDOM === "undefined") {
        return fail(new Error("Libraries did not load (React/ReactDOM/Babel). Check your connection or try again."));
      }
      try {
        var src = document.getElementById("app-src").textContent;
        var out = Babel.transform(src, { presets: [["react", { runtime: "classic" }]] }).code;
        (0, eval)(out);
      } catch (err) { fail(err); }
    }
    if (document.readyState === "complete") { boot(); }
    else { window.addEventListener("load", boot); }
  })();
</script>
